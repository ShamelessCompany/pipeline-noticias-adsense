# Claves de API y configuración opcional

# Google Gemini API Key (para generar guiones editoriales anti-reused content)
# Obtén tu clave gratuita en: https://aistudio.google.com/
GEMINI_API_KEY=

# Discord Webhook URL para el Checkpoint de revisión humana (Opcional)
DISCORD_WEBHOOK_URL=

# Configuración de voz TTS (por defecto es-MX-DaliaNeural o es-ES-AlvaroNeural)
VOICE_NAME=es-MX-DaliaNeural
VOICE_RATE=+0%
VOICE_PITCH=+0Hz

# YouTube Data API (Opcional para subida automática)
YOUTUBE_CLIENT_SECRETS_FILE=client_secrets.json
